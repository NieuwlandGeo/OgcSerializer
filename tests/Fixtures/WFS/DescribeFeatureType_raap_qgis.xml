<?xml version='1.0' encoding="UTF-8" ?>
<schema version="1.0" targetNamespace="http://www.qgis.org/gml" elementFormDefault="qualified">
    <import namespace="http://www.opengis.net/gml" schemaLocation="http://schemas.opengis.net/gml/3.1.1/base/gml.xsd"/>
    <element name="geomorfogenese" substitutionGroup="gml:_Feature" type="qgs:geomorfogeneseType"/>
    <complexType name="geomorfogeneseType">
        <complexContent>
            <extension base="gml:AbstractFeatureType">
                <sequence>
                    <element maxOccurs="1" minOccurs="0" name="geometry" type="gml:PolygonPropertyType"/>
                    <element name="ID" type="long"/>
                    <element nillable="true" name="GEOMORFO" type="string"/>
                    <element nillable="true" name="CODE" type="string"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
</schema>
