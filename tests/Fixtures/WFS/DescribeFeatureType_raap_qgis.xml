<schema version="1.0"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:qgs="http://www.qgis.org/gml" elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:gml="http://www.opengis.net/gml" targetNamespace="http://www.qgis.org/gml"
    xmlns="http://www.w3.org/2001/XMLSchema">
    <import schemaLocation="http://schemas.opengis.net/gml/3.1.1/base/gml.xsd" namespace="http://www.opengis.net/gml"/>
    <element substitutionGroup="gml:_Feature" name="geomorfogenese" type="qgs:geomorfogeneseType"/>
    <complexType name="geomorfogeneseType">
        <complexContent>
            <extension base="gml:AbstractFeatureType">
                <sequence>
                    <element maxOccurs="1" name="geometry" minOccurs="0" type="gml:PolygonPropertyType"/>
                    <element name="ID" type="long"/>
                    <element name="GEOMORFO" type="string" nillable="true"/>
                    <element name="CODE" type="string" nillable="true"/>
                </sequence>
            </extension>
        </complexContent>
    </complexType>
</schema>
